# Copy to .env and fill in. No keys needed: auth is Entra ID via `az login`.

# Foundry portal -> project overview -> "Project endpoint"
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# Name of your model deployment (not necessarily the model name)
MODEL_DEPLOYMENT=gpt-4.1-mini

# Same Foundry resource, Content Safety endpoint (used for Prompt Shields)
CONTENT_SAFETY_ENDPOINT=https://<resource>.cognitiveservices.azure.com
